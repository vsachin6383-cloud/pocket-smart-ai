# Set a long, random value before deployment.
SECRET_KEY=CHANGE_ME_TO_A_UNIQUE_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
DATABASE_URL=sqlite:///./pocketsmart.db
FRONTEND_ORIGINS=http://localhost:5173

# Optional. Without this, PocketSmart uses its private, local insights assistant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
